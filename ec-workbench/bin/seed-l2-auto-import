#!/usr/bin/env python3
"""自动把合格 seed 写入 Hub L2，并写旁路回执。

隔离两档：
  team   — Loop for team（共享）· seed/ + .p0-memory-identity.json
  myself — Loop for myself（个人）· seed-myself/ + .p0-memory-identity-myself.json

用法：
  ./bin/seed-l2-auto-import path/to/seed.md
  ./bin/seed-l2-auto-import --scope team --changed
  ./bin/seed-l2-auto-import --scope myself --all-active
  ./bin/seed-l2-auto-import --scope all --changed
  DRY_RUN=1 ./bin/seed-l2-auto-import --scope myself --changed
"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import subprocess
import sys
import time
import urllib.error
import urllib.request
from datetime import datetime, timezone
from pathlib import Path
from urllib.parse import quote

ROOT = Path(__file__).resolve().parents[1]
REPO = ROOT.parent
IDENT = {
    "team": ROOT / ".p0-memory-identity.json",
    "myself": ROOT / ".p0-memory-identity-myself.json",
}
SEED_ROOT = {
    "team": ROOT / "artifacts" / "memory-l2" / "seed",
    "myself": ROOT / "artifacts" / "memory-l2" / "seed-myself",
}
RECEIPT_ROOT = ROOT / "artifacts" / "memory-l2" / "receipts"
STATE_DIR = ROOT / "state"
CONTAINER = "tdai-memory-core"
CORE = os.environ.get("CORE_URL", "http://127.0.0.1:8420")
HUB = os.environ.get("HUB_URL", "http://127.0.0.1:8125")


def load_ident(scope: str) -> dict:
    path = IDENT[scope]
    if not path.is_file():
        raise SystemExit(f"missing identity for scope={scope}: {path}")
    doc = json.loads(path.read_text())
    doc["scope"] = scope
    return doc


def detect_scope(seed: Path, text: str = "") -> str:
    parts = [p.lower() for p in seed.parts]
    if "seed-myself" in parts:
        return "myself"
    sm = re.search(r"##\s*scope\s*\n\s*(myself|team)\b", text, re.I)
    if sm:
        return sm.group(1).lower()
    return "team"


def hub_path_for(seed: Path) -> str:
    env = os.environ.get("HUB_PATH")
    if env:
        return env
    parts = seed.parts
    for marker in ("seed-myself", "seed"):
        if marker in parts:
            i = parts.index(marker)
            return "ec/" + Path(*parts[i + 1 :]).as_posix()
    return f"ec/{seed.name}"


def parse_seed(text: str) -> dict:
    title = ""
    m = re.search(r"^#\s+(.+)$", text, re.M)
    if m:
        title = m.group(1).strip()[:120]
    decision = ""
    dm = re.search(r"##\s*decision\s*\n(.*?)(?=\n##\s|\Z)", text, re.S | re.I)
    if dm:
        decision = " ".join(dm.group(1).strip().split())[:200]
    status = "active"
    sm = re.search(r"##\s*status\s*\n\s*(\w+)", text, re.I)
    if sm:
        status = sm.group(1).strip().lower()
    return {"title": title, "decision": decision, "status": status}


def eligible(seed: Path, text: str) -> tuple[bool, str]:
    if seed.name == "README.md":
        return False, "readme"
    meta = parse_seed(text)
    if not meta["decision"]:
        return False, "no_decision"
    if meta["status"] == "draft":
        return False, "draft"
    if meta["status"] not in ("active", "superseded"):
        return False, f"bad_status:{meta['status']}"
    return True, "ok"


def file_sha(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def state_path(scope: str) -> Path:
    return STATE_DIR / f"last-seed-import-{scope}"


def load_state(scope: str) -> dict:
    p = state_path(scope)
    # migrate old single state into team once
    legacy = STATE_DIR / "last-seed-import"
    if not p.is_file() and scope == "team" and legacy.is_file():
        return json.loads(legacy.read_text())
    if p.is_file():
        try:
            return json.loads(p.read_text())
        except json.JSONDecodeError:
            return {}
    return {}


def save_state(scope: str, files: dict[str, str], last_receipt: str) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    doc = {
        "scope": scope,
        "updated_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "files": files,
        "last_receipt": last_receipt,
    }
    state_path(scope).write_text(json.dumps(doc, ensure_ascii=False, indent=2) + "\n")


def collect_all(scope: str) -> list[Path]:
    root = SEED_ROOT[scope]
    if not root.is_dir():
        return []
    return sorted(p for p in root.rglob("*.md") if p.name != "README.md")


def collect_from_git(rev_range: str, scopes: list[str]) -> list[Path]:
    paths_arg = []
    if "team" in scopes:
        paths_arg.append("ec-workbench/artifacts/memory-l2/seed")
    if "myself" in scopes:
        paths_arg.append("ec-workbench/artifacts/memory-l2/seed-myself")
    r = subprocess.run(
        ["git", "-C", str(REPO), "diff", "--name-only", "--diff-filter=AM", rev_range, "--", *paths_arg],
        capture_output=True,
        text=True,
        check=False,
    )
    out: list[Path] = []
    for line in r.stdout.splitlines():
        p = REPO / line.strip()
        if p.is_file() and p.suffix == ".md":
            out.append(p)
    return out


def collect_changed(scopes: list[str]) -> list[Path]:
    changed: list[Path] = []
    for scope in scopes:
        old = load_state(scope).get("files") or {}
        for p in collect_all(scope):
            rel = str(p.relative_to(ROOT))
            if old.get(rel) != file_sha(p):
                changed.append(p)
    return changed


def import_one(seed: Path, scope: str, ident: dict, dry_run: bool) -> dict:
    text = seed.read_text(encoding="utf-8", errors="ignore")
    ok, reason = eligible(seed, text)
    meta = parse_seed(text)
    hub_path = hub_path_for(seed)
    base = {
        "scope": scope,
        "file": str(seed.relative_to(ROOT)) if ROOT in seed.parents else str(seed),
        "hub_path": hub_path,
        "title": meta["title"] or hub_path,
        "decision": meta["decision"],
        "status": meta["status"],
        "team_id": ident.get("team_id"),
        "agent_id": ident.get("agent_id"),
    }
    if not ok:
        return {**base, "skipped": True, "reason": reason}
    if dry_run:
        return {**base, "dry_run": True, "write_ok": True, "reason": reason}

    team, agent, user = ident["team_id"], ident["agent_id"], ident["user_id"]
    key = ident["user_key"]
    service = ident.get("service_id", "default")
    profile = f"team:{team}|agent:{agent}"
    scope_enc = quote(profile, safe="")
    dest_dir = f"/data/tdai-memory/profiles/{scope_enc}/scene_blocks/{Path(hub_path).parent.as_posix()}"
    dest = f"/data/tdai-memory/profiles/{scope_enc}/scene_blocks/{hub_path}"

    try:
        subprocess.run(["docker", "exec", CONTAINER, "mkdir", "-p", dest_dir], check=True, capture_output=True)
        subprocess.run(
            ["docker", "exec", "-i", CONTAINER, "tee", dest],
            input=text.encode(),
            check=True,
            capture_output=True,
        )
    except (subprocess.CalledProcessError, FileNotFoundError) as e:
        return {**base, "write_ok": False, "error": f"docker:{e}"}

    headers = {
        "Content-Type": "application/json",
        "Authorization": "Bearer local",
        "x-tdai-service-id": service,
        "x-tdai-user-key": key,
    }
    iso = {"team_id": team, "agent_id": agent, "user_id": user}

    def post(url: str, payload: dict) -> dict:
        req = urllib.request.Request(
            url, data=json.dumps(payload).encode(), headers=headers, method="POST"
        )
        with urllib.request.urlopen(req, timeout=60) as resp:
            return json.load(resp)

    now = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.%f")[:-3] + "Z"
    try:
        write = post(
            f"{CORE.rstrip('/')}/v3/scenario/write",
            {
                **iso,
                "path": hub_path,
                "content": text,
                "summary": meta["title"] or hub_path,
                "updated_at": now,
            },
        )
        read = post(f"{CORE.rstrip('/')}/v3/scenario/read", {**iso, "path": hub_path})
    except (urllib.error.URLError, urllib.error.HTTPError, TimeoutError, json.JSONDecodeError) as e:
        return {**base, "write_ok": False, "error": f"core:{e}"}

    import_status: object = None
    try:
        l0 = {
            "team_id": team,
            "agent_id": agent,
            "session_id": f"seed-auto-{scope}-{Path(hub_path).stem}-{int(time.time())}",
            "messages": [
                {"role": "user", "content": f"请记住判决：{meta['title'] or hub_path}"},
                {"role": "assistant", "content": text[:2000]},
            ],
        }
        req = urllib.request.Request(
            f"{HUB.rstrip('/')}/api/v1/chat-memory/import",
            data=json.dumps(l0).encode(),
            headers={
                "Content-Type": "application/json",
                "Authorization": f"Bearer {key}",
                "x-tdai-user-key": key,
                "x-tdai-service-id": service,
            },
            method="POST",
        )
        with urllib.request.urlopen(req, timeout=60) as resp:
            import_status = resp.status
    except Exception as e:  # noqa: BLE001
        import_status = f"err:{e}"

    content = (read or {}).get("content") or (read or {}).get("data")
    return {
        **base,
        "write_ok": bool(write),
        "read_has_content": bool(content),
        "import_status": import_status,
        "reason": reason,
    }


def write_receipt(results: list[dict], mode: str, scope_label: str) -> Path:
    out_dir = RECEIPT_ROOT / scope_label if scope_label in ("team", "myself") else RECEIPT_ROOT
    out_dir.mkdir(parents=True, exist_ok=True)
    RECEIPT_ROOT.mkdir(parents=True, exist_ok=True)
    day = datetime.now().strftime("%Y%m%d-%H%M%S")
    written = [r for r in results if r.get("write_ok") and not r.get("skipped")]
    skipped = [r for r in results if r.get("skipped")]
    failed = [r for r in results if not r.get("skipped") and not r.get("write_ok")]

    lines = [
        f"# Memory 回执 · {scope_label} · {day}",
        "",
        f"模式：`{mode}` · Loop for **{scope_label}** · 自动写 Hub，旁路可见。",
        "",
        f"| 写入 | 跳过 | 失败 |",
        f"|---|---|---|",
        f"| {len(written)} | {len(skipped)} | {len(failed)} |",
        "",
    ]
    if written:
        lines += ["## 已记下", ""]
        for r in written:
            lines.append(
                f"- **[{r.get('scope','')}] `{r['hub_path']}`** — {r.get('title','')}"
            )
            if r.get("decision"):
                lines.append(f"  - {r['decision']}")
        lines.append("")
    if skipped:
        lines += ["## 跳过", ""] + [f"- `{r['hub_path']}` ({r.get('reason')})" for r in skipped] + [""]
    if failed:
        lines += ["## 失败", ""] + [f"- `{r['hub_path']}` — {r.get('error')}" for r in failed] + [""]

    text = "\n".join(lines) + "\n"
    md = out_dir / f"receipt-{day}.md"
    latest_scope = out_dir / "latest.md"
    latest_root = RECEIPT_ROOT / "latest.md"
    md.write_text(text, encoding="utf-8")
    latest_scope.write_text(text, encoding="utf-8")
    latest_root.write_text(text, encoding="utf-8")
    (out_dir / f"receipt-{day}.json").write_text(
        json.dumps({"mode": mode, "scope": scope_label, "results": results}, ensure_ascii=False, indent=2)
        + "\n",
        encoding="utf-8",
    )
    return md


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("seeds", nargs="*", type=Path)
    ap.add_argument("--scope", choices=("team", "myself", "all"), default="all")
    ap.add_argument("--all-active", action="store_true")
    ap.add_argument("--changed", action="store_true")
    ap.add_argument("--from-git", default="")
    ap.add_argument("--dry-run", action="store_true")
    args = ap.parse_args()
    dry = args.dry_run or os.environ.get("DRY_RUN") == "1"
    scopes = ["team", "myself"] if args.scope == "all" else [args.scope]

    paths: list[Path] = []
    mode = "explicit"
    if args.seeds:
        paths = [p if p.is_absolute() else (Path.cwd() / p).resolve() for p in args.seeds]
        mode = "explicit"
    elif args.from_git:
        paths = collect_from_git(args.from_git, scopes)
        mode = f"from-git:{args.from_git}"
    elif args.changed:
        paths = collect_changed(scopes)
        mode = "changed"
    elif args.all_active:
        for s in scopes:
            paths.extend(collect_all(s))
        mode = "all-active"
    else:
        ap.print_help()
        return 2

    seen: set[Path] = set()
    uniq: list[Path] = []
    for p in paths:
        rp = p.resolve()
        if rp in seen or not rp.is_file():
            continue
        seen.add(rp)
        uniq.append(rp)

    scope_label = args.scope
    if not uniq:
        print("no seeds to import")
        receipt = write_receipt([], mode, scope_label if scope_label != "all" else "team")
        print(f"receipt {receipt}")
        return 0

    idents = {s: load_ident(s) for s in ("team", "myself") if s in scopes or args.seeds}
    # for explicit paths may need both idents
    if args.seeds:
        idents = {"team": load_ident("team"), "myself": load_ident("myself")}

    results: list[dict] = []
    for p in uniq:
        text = p.read_text(encoding="utf-8", errors="ignore")
        scope = detect_scope(p, text)
        if args.scope != "all" and scope != args.scope and not args.seeds:
            continue
        if args.seeds and args.scope != "all" and scope != args.scope:
            # explicit file: honor --scope override
            scope = args.scope
        if scope not in idents:
            idents[scope] = load_ident(scope)
        results.append(import_one(p, scope, idents[scope], dry))

    receipt = write_receipt(results, mode + (" dry-run" if dry else ""), scope_label)

    if not dry:
        # refresh state per scope touched
        touched = {r["scope"] for r in results if not r.get("skipped")}
        for s in touched or scopes:
            files = {str(p.relative_to(ROOT)): file_sha(p) for p in collect_all(s)}
            save_state(s, files, str(receipt))

    written = sum(1 for r in results if r.get("write_ok") and not r.get("skipped"))
    skipped = sum(1 for r in results if r.get("skipped"))
    failed = sum(1 for r in results if not r.get("skipped") and not r.get("write_ok"))
    print(f"wrote={written} skipped={skipped} failed={failed} scope={args.scope}")
    print(f"receipt {receipt}")
    for r in results:
        tag = r.get("scope", "?")
        if r.get("write_ok") and not r.get("skipped"):
            print(f"  ✓ [{tag}] {r['hub_path']} — {r.get('title','')[:50]}")
        elif r.get("skipped"):
            print(f"  · skip [{tag}] {r['hub_path']} ({r.get('reason')})")
        else:
            print(f"  ✗ [{tag}] {r['hub_path']} {r.get('error')}")
    return 1 if failed else 0


if __name__ == "__main__":
    raise SystemExit(main())
